# ----------------------------
# WORKSPACES → MONITORS
# ----------------------------
set $ws1 "1: Browser"
set $ws2 "2: Discord"
set $ws3 "3"
set $ws4 "4: Notes"
set $ws5 "5: Work"
set $ws6 "6: Drive"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9: Spotify"

workspace $ws1 output DP-1
workspace $ws2 output DP-1
workspace $ws3 output DP-1

workspace $ws4 output DP-2
workspace $ws5 output DP-2
workspace $ws6 output DP-2

workspace $ws7 output HDMI-1
workspace $ws8 output HDMI-1
workspace $ws9 output HDMI-1


# ----------------------------
# KEYBINDS (FIXED)
# ----------------------------

bindsym $mod+1 workspace $ws1; exec --no-startup-id google-chrome --profile-directory="Default"
bindsym $mod+2 workspace $ws2; exec discord
bindsym $mod+3 workspace $ws3

bindsym $mod+4 workspace $ws4; exec --no-startup-id ~/.local/bin/notes_station
bindsym $mod+5 workspace $ws5; exec wezterm

bindsym $mod+6 workspace $ws6; exec --no-startup-id google-chrome --profile-directory="Drive" "https://drive.google.com"

bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9; exec spotify


# ----------------------------
# MOVE WINDOWS
# ----------------------------

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9


