# ------------------------------------------------------------------------------
# # Notes: Workspace to Monitor Assignment
# Assign 9 workspaces: 3 per monitor (left/main/right)
# Monitors (from xrandr):
# - Left (Workspaces 1-3): DP-1 (1920x1080+0+0)
# - Main/Primary (Workspaces 4-6): DP-2 (1920x1080+1920+0)
# - Right (Workspaces 7-9): HDMI-1 (1920x1080+3840+0)
# ------------------------------------------------------------------------------
workspace 1 output DP-1  # Workspace 1 → Left monitor
workspace 2 output DP-1  # Workspace 2 → Left monitor
workspace 3 output DP-1  # Workspace 3 → Left monitor
workspace 4 output DP-2  # Workspace 4 → Main/Primary monitor
workspace 5 output DP-2  # Workspace 5 → Main/Primary monitor
workspace 6 output DP-2  # Workspace 6 → Main/Primary monitor
workspace 7 output HDMI-1 # Workspace 7 → Right monitor
workspace 8 output HDMI-1 # Workspace 8 → Right monitor
workspace 9 output HDMI-1 # Workspace 9 → Right monitor

# ------------------------------------------------------------------------------
# # Notes: Modifier Key Definition
# Use $mod variable for easier customization
# Currently: Mod4 = Windows key
# Change to Mod1 for Alt key
# ------------------------------------------------------------------------------
set $mod Mod4

# Rotate third monitor (HDMI-1) to right (portrait mode)
exec --no-startup-id xrandr --output HDMI-1 --mode 1920x1080 --pos 3840x0 --rotate right

bindsym $mod+d exec dmenu_run
bindsym $mod+Return exec wezterm
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec i3-msg exit
bindsym $mod+Control+r exec i3-msg exit

# ------------------------------------------------------------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# ------------------------------------------------------------------------------
# # Notes: Workspace Switching & Moving Keybindings
# $mod+<number> switches to workspace <number>
# $mod+Shift+<number> moves focused window to workspace <number>
# Workspace to Monitor Mapping:
# - $mod+1-3 / $mod+Shift+1-3 → Left monitor (DP-1)
# - $mod+4-6 / $mod+Shift+4-6 → Main monitor (DP-2)
# - $mod+7-9 / $mod+Shift+7-9 → Right monitor (HDMI-1)
# ------------------------------------------------------------------------------
# Switch to workspace ($mod+<number>)

set $workspace1 "1: Browser"
set $workspace2 "2: Discord"
set $workspace4 "4: Notes"
set $workspace5 "5: work"
set $workspace9 "9: Spotify"

# $mod+1 switches to workspace 1 (left monitor DP-1)
bindsym $mod+1 workspace $workspace1
# $mod+2 opens Discord on workspace 2 (left monitor DP-1)
bindsym $mod+2 workspace $workspace2; exec discord
bindsym $mod+3 workspace number 3
# $mod+4 opens WezTerm with tmux in ~/notes + nvim
bindsym $mod+4 workspace $workspace4; exec --no-startup-id ~/.local/bin/notes_station
# $mod+5 opens WezTerm with tmux on workspace 5 (main monitor DP-2)
bindsym $mod+5 workspace number 5; exec wezterm
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9; exec spotify

# Move focused window to workspace ($mod+Shift+<number>)
# $mod+Shift+1 opens Chrome on workspace 1 if not already running
bindsym $mod+Shift+1 exec --no-startup-id bash -c 'pgrep -x google-chrome > /dev/null || google-chrome'
bindsym $mod+Shift+2 move container to workspace $workspace2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace $workspace4
bindsym $mod+Shift+5 move container to workspace $workspace5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

assign [class="Google-chrome"] $workspace1
assign [class="org.wezfurlong.wezterm"] $workspace5
assign [class="Spotify"] $workspace9

bar {
  status_command i3status
}
